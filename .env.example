# Copiar a .env (cp .env.example .env) y completar. El archivo .env está en .gitignore.
#
# CONTRASEÑAS: usar SOLO letras y números (sin $ " ' \ espacios), de 20+ caracteres.
# Se interpolan en JSON y en shell; los caracteres especiales rompen los scripts.
# Generar cada una con:  openssl rand -hex 16

# --- Versión del stack (ES, Kibana, Logstash y Filebeat DEBEN coincidir) ---
# 9.5.6 = último parche publicado de la rama 9.5 al 17/11/2026 (verificado en
# artifacts.elastic.co y docker.elastic.co). No usar "latest".
STACK_VERSION=9.5.6
CLUSTER_NAME=sor2-lab

# --- Red ---
# IP host-only de la VM. Kibana se publica SOLO en esta IP; ES y Logstash solo en 127.0.0.1.
LAB_IP=192.168.56.10
LAB_NET=192.168.56.0/24

# --- Recursos (documentar en el informe) ---
ES_HEAP=2g
ES_MEM_LIMIT=3g
# Kibana 9.x usó 966 MiB de 1 GiB (94 %) recién arrancado: se sube a 1,5 GiB para evitar que lo mate el OOM.
KIBANA_MEM_LIMIT=1536m
LS_HEAP=512m
LS_MEM_LIMIT=1g

# --- Credenciales ---
# Superusuario: solo administración y setup (no lo usan los servicios ni los scripts de análisis).
ELASTIC_PASSWORD=cambiar_por_hex_aleatorio
# Usuario interno de Kibana (kibana_system).
KIBANA_PASSWORD=cambiar_por_hex_aleatorio
# Clave de cifrado de saved objects de Kibana: exactamente 32+ caracteres (openssl rand -hex 16 da 32).
KIBANA_ENCRYPTION_KEY=cambiar_por_hex_de_32_caracteres
# Logstash escribe con logstash_internal (rol logstash_writer: solo escritura en lab-*).
LOGSTASH_INTERNAL_PASSWORD=cambiar_por_hex_aleatorio
# Scripts de Python (extracción, detectores) usan lab_analyst (lee lab-*, escribe solo lab-alertas*).
ANALYST_PASSWORD=cambiar_por_hex_aleatorio
